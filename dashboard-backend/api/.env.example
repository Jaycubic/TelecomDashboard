# PostgreSQL Database Configuration
DBPB_HOST=localhost
DBPB_PORT=5432
DBPB_USER=jofrey
DBPB_PASSWORD=2025
DBPB_NAME=dashboard
DBPB_SCHEMA=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 8094/8095 as you assigned; Python analytics service (if any) uses 8096
PORT=8094
CACHE_TTL_SECONDS=300

# comma-separated list of origins allowed to call this API (or leave unset for all origins '*')
CORS_ORIGIN=http://192.168.8.10:8099,http://localhost:8099

# Frontend static server configuration (frontend-server.js)
FRONTEND_PORT=8099
BACKEND_API_URL=http://192.168.8.10:8094
# Optional override if dist is placed elsewhere:
# FRONTEND_DIST_DIR=../../dashboard-frontend/dist

# India Geodata map source (optional overrides; defaults point to the public repo)
# MAP_SHP_URL=https://raw.githubusercontent.com/yashveeeeeeer/india-geodata/main/data/administrative/states/datameet/Admin2.shp
# MAP_DBF_URL=https://raw.githubusercontent.com/yashveeeeeeer/india-geodata/main/data/administrative/states/datameet/Admin2.dbf
